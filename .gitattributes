# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Source code
*.java text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.gradle text eol=lf

# Binary files
*.apk binary
*.aar binary
*.jar binary
*.so binary
*.a binary
*.o binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# Documents
*.pdf binary
